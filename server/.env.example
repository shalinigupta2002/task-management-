NODE_ENV=development
PORT=8080

# ── Neon PostgreSQL (Prisma) ───────────────────────────────────────────────
# Keep real credentials only in local .env (gitignored) or Render Environment.
# Never commit passwords or full connection strings with secrets.
#
# DATABASE_URL = pooled / app runtime connection (hostname contains "-pooler")
# DIRECT_URL   = direct connection for `prisma migrate deploy` (no "-pooler")
#
# Current production Neon hosts (us-east-2 / c-5):
#   pooled: ep-wandering-bread-ayawi4h7-pooler.c-5.us-east-2.aws.neon.tech
#   direct: ep-wandering-bread-ayawi4h7.c-5.us-east-2.aws.neon.tech
#
# Copy the full connection strings from the Neon console (include user, password,
# database name, sslmode=require). For the pooled URL also add pgbouncer=true.
#
# Placeholders only — replace USER, PASSWORD, and db name as needed:
DATABASE_URL="postgresql://USER:PASSWORD@ep-wandering-bread-ayawi4h7-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-wandering-bread-ayawi4h7.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ── Render (backend) ───────────────────────────────────────────────────────
# Root Directory : server
# Build Command  : npm install && npm run build
#                  (runs prisma generate + prisma migrate deploy)
# Start Command  : npm start
# Set DATABASE_URL, DIRECT_URL, JWT_SECRET, CORS_ORIGIN in Render → Environment.
# Do NOT set VITE_API_BASE_URL here (that belongs on Vercel for the frontend).

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Exact frontend origin(s). Production example:
# CORS_ORIGIN=https://assigner-tawny.vercel.app
# Local:
CORS_ORIGIN=http://localhost:5173

# In production, leave unset/false unless you intentionally expose API docs
SWAGGER_ENABLED=false

SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=60000

# Development/staging test user password (used by npm run db:seed:test)
# DEVELOPMENT ONLY — never use in production
SEED_DEV_PASSWORD=DevTest@2026!

PAYMENT_HMAC_SECRET=change-me-payment-hmac
# Optional Razorpay (when set, PaymentProvider.mode = RAZORPAY)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
