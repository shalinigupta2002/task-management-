NODE_ENV=development
PORT=8080

# Neon PostgreSQL (Prisma)
# DATABASE_URL  = pooled connection (ends with -pooler....neon.tech) — used by the app at runtime
# DIRECT_URL    = direct connection (same host without -pooler) — used by Prisma migrate
#
# Both should include sslmode=require. Copy values from the Neon console → Connection details.
# Example shapes (placeholders only — never commit real credentials):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Exact frontend origin(s). Production example:
# CORS_ORIGIN=https://assigner-tawny.vercel.app
# Local:
CORS_ORIGIN=http://localhost:5173

# In production, leave unset/false unless you intentionally expose API docs
SWAGGER_ENABLED=false

SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=60000

# Development/staging test user password (used by npm run db:seed:test)
# DEVELOPMENT ONLY — never use in production
SEED_DEV_PASSWORD=DevTest@2026!

PAYMENT_HMAC_SECRET=change-me-payment-hmac
# Optional Razorpay (when set, PaymentProvider.mode = RAZORPAY)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
