# Copy to `.env` for local overrides (optional — defaults already work for local/prod).
# Vite only exposes variables prefixed with VITE_.

# Local development (default when running `npm run dev`):
# VITE_API_BASE_URL=http://localhost:8080/api

# Production / Vercel (also set this in Vercel → Project → Settings → Environment Variables):
# VITE_API_BASE_URL=https://task-management-06db.onrender.com/api

# ── Playwright E2E (not prefixed with VITE_ — used only by Playwright) ──
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# PLAYWRIGHT_TEST_EMAIL=
# PLAYWRIGHT_TEST_PASSWORD=
# Optional role-specific overrides:
# PLAYWRIGHT_SUPER_ADMIN_EMAIL=
# PLAYWRIGHT_SUPER_ADMIN_PASSWORD=
# PLAYWRIGHT_MAIN_ADMIN_EMAIL=
# PLAYWRIGHT_MAIN_ADMIN_PASSWORD=
# PLAYWRIGHT_SUB_ADMIN_EMAIL=
# PLAYWRIGHT_SUB_ADMIN_PASSWORD=
# PLAYWRIGHT_EMPLOYEE_EMAIL=
# PLAYWRIGHT_EMPLOYEE_PASSWORD=
# PLAYWRIGHT_USE_SYSTEM_CHROME=1
# PLAYWRIGHT_USE_BUNDLED_CHROMIUM=1
